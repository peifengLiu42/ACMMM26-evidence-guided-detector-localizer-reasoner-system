# Copy this file to configs/eval_dinov3conv.env and edit local paths.

PYTHON_BIN=python
CUDA_VISIBLE_DEVICES=0

DINO_MODEL_PATH=checkpoint/dinov3-vitb16-pretrain-lvd1689m
CHECKPOINT=checkpoints/dinov3-conv

BATCH_SIZE=8
NUM_WORKERS=4
CLS_THRESHOLD=0.5
MASK_THRESHOLD=0.5
GATE_MASKS_BY_CLS=True

# Semicolon-separated specs in the form:
#   name:image_dir:mask_dir
EVAL_DATASETS=RealText:data/test/images:data/test/masks

OUTPUT_JSON=outputs/eval/dinov3conv_metrics.json
PROB_OUTPUT_DIR=outputs/eval/dinov3conv_probs

# Optional. Leave empty to skip the extra metric script.
METRIC_SCRIPT=tools/compute_matrix_global.py
METRIC_WORKERS=8
