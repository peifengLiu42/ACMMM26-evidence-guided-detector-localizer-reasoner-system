# Copy this file to configs/train_dinov3conv.env and edit local paths.

PYTHON_BIN=python
TORCHRUN_BIN=torchrun
CUDA_VISIBLE_DEVICES=0
NUM_GPUS=1
MASTER_PORT=29502

# Either a local DINOv3 directory or a Hugging Face / ModelScope model id accepted by transformers.
DINO_MODEL_PATH=checkpoint/dinov3-vitb16-pretrain-lvd1689m

# Training data.
# SFT JSON must be a list. Each item should contain an image path and an assistant
# answer with FORGED or AUTHENTIC. See configs/sft_sample.json.
SFT_JSON_PATH=data/train_sft.json
VAL_SFT_JSON_PATH=data/val_sft.json
TRAIN_EXCLUDE_LIST=/path/to/RealTextV2/train/test.txt

# Optional mask root used to derive forged-mask paths as:
#   ${MASK_ROOT}/${image_parent_name}/${image_stem}_mask.png
MASK_ROOT=data/train_masks

OUTPUT_DIR=runs/dinov3conv-localizer-1344x896
INIT_CHECKPOINT=

PRECISION=fp32
IMAGE_SIZE=1024
IMAGE_HEIGHT=896
IMAGE_WIDTH=1344
DECODER_DIM=256

# Keep this as conv for the DINOv3Conv model.
MASK_HEAD_TYPE=conv

AUGMENT=True
RANDOM_RESIZED_CROP_SCALE=0.9
ROTATION_DEGREES=3.0
HFLIP_PROB=0.0
COLOR_JITTER=0.1

FREEZE_DINO=False
UNFREEZE_LAST_N_LAYERS=-1

BATCH_SIZE=12
GRAD_ACCUMULATION_STEPS=1
EPOCHS=12
MAX_STEPS=-1
LR=1e-5
HEAD_LR=1e-4
WEIGHT_DECAY=0.01
NUM_WORKERS=8
LIMIT_SAMPLES=-1
VAL_LIMIT_SAMPLES=-1

EVAL_STEPS=0
EVAL_EPOCHS=1
SAVE_EPOCHS=1
KEEP_LAST_EPOCH_CHECKPOINTS=2
LOG_STEPS=10

CLS_LOSS_WEIGHT=1.0
MASK_BCE_WEIGHT=1.0
MASK_DICE_WEIGHT=1.0
MAX_MASK_POS_WEIGHT=100.0
CLS_THRESHOLD=0.5
MASK_THRESHOLD=0.5
DDP_FIND_UNUSED_PARAMETERS=False
SEED=42
