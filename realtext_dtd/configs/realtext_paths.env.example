# Copy this file to configs/realtext_paths.env and edit the paths.

# RealTextV2 data. Masks are expected to mirror the image subdirectories.
REALT_TRAIN_IMAGE_DIR=/path/to/RealTextV2/train/image
REALT_TRAIN_MASK_DIR=/path/to/RealTextV2/train/regen_mask
REALT_VAL_LIST=/path/to/RealTextV2/train/test.txt
TRAIN_EXCLUDE_LIST=/path/to/RealTextV2/train/test.txt

# Difficulty mining inputs. These directories should be generated with the
# corresponding upstream model implementations.
DOC_PRED_DIR=/path/to/DocTamper/train_probability_maps
RTM_PRED_DIR=/path/to/RTM/train_probability_maps
SPARSE_PRED_DIR=/path/to/SparseViT/realtext_train_heatmaps
DIFFICULTY_DIR=$REPO_DIR/outputs/difficulty_mining/realtext_train
DIFFICULTY_MANIFEST=$DIFFICULTY_DIR/difficulty_manifest.csv
HARD_REGIONS_PATH=$DIFFICULTY_DIR/hard_regions.json
